# Copy to .env and fill in. .env is gitignored.

# The player's IP address. Give it a DHCP reservation so it never changes.
PLAYER=192.168.1.50

# Library folders on this host. Mounted read-only.
MUSIC_DIR=/srv/media/music
PODCAST_DIR=/srv/media/podcasts

# Where the sync keeps its state (logs, settings, last preview).
STATE_DIR=./state

TZ=UTC

# --- optional ---------------------------------------------------------------

# Podgrab's API, for the "new episodes" card. Only reachable by container
# name if this stack shares Podgrab's Docker network (see compose.yaml).
# PODGRAB_URL=http://podgrab:8080

# Home Assistant push notifications. Create the token in HA under
# profile -> Security -> Long-lived access tokens.
# HA_URL=http://192.168.1.20:8123
# HA_TOKEN=
# HA_SERVICE=notify.mobile_app_<your_phone>
# PUBLIC_URL=http://192.168.1.10:8787/
